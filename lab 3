
# Function that adds two numbers
def add(x,y):
    print(x+y)
def add(x, y):
    print(x + y)


# Function that subtracts two numbers...
def sub(x, y):
    print(x - y)


# Function that multiples two numbers...
def mul(x, y):
    print(x * y)


# Function that divides two numbers...
def div(x, y):
    print(x / y)

#---------------------------------------------------------------------------------------------

print("Welcome to mwah's super duper aesthetic and lovely calculator")

while True:
    print("What do you need help calculating?")
    print("Type (a)dd (s)subtract (m)ultiply (d)ivide, or type quit")

    user_choice = input(": ").lower()

    if user_choice in ("q", "quit"):
        print("Shutting down...")
        break

    x = int(input("Enter the first number: "))
    y = int(input("Enter the second number: "))

    if user_choice == 'a':
        add(x, y)

    elif user_choice == 's':
        sub(x, y)

    elif user_choice == 'm':
        mul(x, y)

    elif user_choice == 'd':
        div(x, y)

    else:
        print("Invalid input, please try again.")
