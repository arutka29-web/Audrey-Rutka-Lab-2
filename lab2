import random


attempts = 0
game_number = random.randint(1, 10)

while True:
    attempts += 1
    guess = int(input("Enter a number between 1 and 10: "))

    if guess > game_number:
        print("Too high")
    elif guess < game_number:
        print("Too low")
    else:
        print("You win!")

        if attempts == 1:
            print("Amazing! First attempt!")
        elif attempts == 2:
            print("Great job! 2 attempts!")
        elif attempts == 3:
            print("Good job! 3 attempts!")
        elif attempts == 4:
            print("Nice work! 4 attempts!")
        elif attempts == 5:
            print("Not bad! 5 attempts!")
        elif attempts == 6:
            print("You got it in 6 attempts!")
        elif attempts == 7:
            print("You got it in 7 attempts!")
        elif attempts == 8:
            print("You got it in 8 attempts!")
        elif attempts == 9:
            print("You got it in 9 attempts!")
        else:
            print("You got it in 10 or more attempts!")

        break